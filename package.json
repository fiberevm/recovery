{
  "name": "fiber-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone, browser-only recovery for Fiber .fiberseed backups.",
  "scripts": {
    "dev": "bun scripts/serve.ts",
    "build": "bun scripts/build.ts",
    "fixture": "bun scripts/make-fixture.ts",
    "typecheck": "bun build --check ./src/app.ts --outdir /tmp/fiber-recovery-check",
    "snapshot": "bun scripts/snapshot.ts",
    "artifacts": "bun scripts/artifacts.ts"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@railgun-community/engine": "github:fiberevm/railgun-engine#f569d52",
    "brotli": "1.3.3",
    "ethers": "6.14.3",
    "memdown": "6.1.1",
    "snarkjs": "0.7.6"
  },
  "overrides": {
    "micro-ftch": "file:./shims/micro-ftch",
    "web3": "file:./shims/unused",
    "bfj": "file:./shims/unused",
    "r1csfile": "file:./shims/unused",
    "ejs": "file:./shims/unused",
    "@iden3/binfileutils": "file:./shims/unused",
    "circom_runtime": "file:./shims/unused",
    "fastfile": "file:./shims/unused",
    "logplease": "file:./shims/unused",
    "bn.js": "5.2.5",
    "ws": "8.21.3"
  }
}
